# Supabase — copy these from your Supabase project: Settings → API
# Then create a file named .env.local (NOT committed) with the real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Twelve Data — free key from twelvedata.com for LIVE commodity prices
# (gold/oil/copper). Optional: without it, commodities fall back to SAMPLE.
# Crypto uses Binance's public API and needs no key.
TWELVE_DATA_API_KEY=your-twelve-data-key

# Optional: force sample-only data (offline dev). Leave unset for live data.
# DATA_SOURCE=mock

# Stripe (Phase B — paywall). From your Stripe dashboard (use TEST keys first).
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PRICE_ID=price_your_monthly_price_id       # the ₱499/mo recurring price
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret    # for the subscription webhook

# Supabase SERVICE ROLE key (SECRET — Settings → API). Lets the Stripe webhook
# update a user's subscription tier. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used for Stripe redirects (dev default shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
